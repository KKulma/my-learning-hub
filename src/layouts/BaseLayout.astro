---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Kasia's take on papers, courses, and certification prep" } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Kasia's Learning Hub</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased min-h-screen flex flex-col selection:bg-indigo-100 selection:text-indigo-800">
    <!-- Navigation Header -->
    <header class="sticky top-0 z-40 w-full border-b border-slate-200/80 bg-white/80 backdrop-blur-md">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href={`${base}/`} class="flex items-center gap-2 group">
          <span class="font-bold text-lg text-slate-900 group-hover:text-indigo-600 transition">
            Kasia's Learning Hub
          </span>
        </a>

        <nav class="flex items-center gap-1 sm:gap-2 text-sm font-medium">
          <a
            href={`${base}/`}
            class:list={[
              "px-3 py-1.5 rounded-lg transition",
              currentPath === `${base}/` || currentPath === `${base}` ? "bg-indigo-50 text-indigo-700 font-semibold" : "text-slate-600 hover:text-slate-900 hover:bg-slate-100"
            ]}
          >
            All
          </a>
          <a
            href={`${base}/resources`}
            class:list={[
              "px-3 py-1.5 rounded-lg transition",
              currentPath.startsWith(`${base}/resources`) ? "bg-indigo-50 text-indigo-700 font-semibold" : "text-slate-600 hover:text-slate-900 hover:bg-slate-100"
            ]}
          >
            Resources
          </a>
          <a
            href={`${base}/courses`}
            class:list={[
              "px-3 py-1.5 rounded-lg transition",
              currentPath.startsWith(`${base}/courses`) ? "bg-indigo-50 text-indigo-700 font-semibold" : "text-slate-600 hover:text-slate-900 hover:bg-slate-100"
            ]}
          >
            Courses
          </a>
          <a
            href={`${base}/search`}
            class:list={[
              "px-3 py-1.5 rounded-lg transition flex items-center gap-1.5",
              currentPath.startsWith(`${base}/search`) ? "bg-indigo-50 text-indigo-700 font-semibold" : "text-slate-600 hover:text-slate-900 hover:bg-slate-100"
            ]}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span class="hidden sm:inline">Search</span>
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200 bg-white py-8 text-center text-sm text-slate-500">
      <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>Kasia's Learning Hub • Personal Knowledge Base</p>
        <p class="text-xs text-slate-400">Built with Astro & Tailwind CSS</p>
      </div>
    </footer>
  </body>
</html>
