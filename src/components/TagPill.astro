---
interface Props {
  tag: string;
  size?: 'sm' | 'md';
  active?: boolean;
}

const { tag, size = 'sm', active = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a
  href={`${base}/tags/${encodeURIComponent(tag.toLowerCase())}`}
  class:list={[
    "inline-flex items-center rounded-full font-medium transition shadow-sm",
    size === 'sm' ? "px-2.5 py-0.5 text-xs" : "px-3.5 py-1 text-sm",
    active
      ? "bg-indigo-600 text-white hover:bg-indigo-700"
      : "bg-slate-100 text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 border border-slate-200/80"
  ]}
>
  #{tag}
</a>
