---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Search" description="Search across all learning resources and courses.">
  <div class="max-w-3xl mx-auto">
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-extrabold text-slate-900">Search Knowledge Base</h1>
      <p class="text-slate-600 mt-2">Full-text instant search across all your papers, resources, and courses.</p>
    </div>

    <!-- Pagefind container (active in production build after pagefind indexes) -->
    <div id="search-container" class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm min-h-[300px]">
      <div id="search"></div>
    </div>
  </div>
</BaseLayout>

<link rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />
<script is:inline src={`${base}/pagefind/pagefind-ui.js`}></script>

<script is:inline define:vars={{ base }}>
  window.addEventListener('DOMContentLoaded', () => {
    if (typeof PagefindUI !== 'undefined') {
      new PagefindUI({
        element: "#search",
        baseUrl: base || "/",
        bundlePath: (base || "") + "/pagefind/",
        showSubResults: true,
        showImages: false,
      });
    } else {
      const container = document.getElementById('search');
      if (container) {
        container.innerHTML = `
          <div class="text-center py-8 text-slate-500">
            <p class="font-medium text-slate-700 mb-1">Pagefind index runs on production build.</p>
            <p class="text-sm">For instant search during local development, use the live search bar on the <a href="${base || '/'}" class="text-indigo-600 underline font-medium">Home page</a>.</p>
          </div>
        `;
      }
    }
  });
</script>

<style is:global>
  :root {
    --pagefind-ui-scale: 0.95;
    --pagefind-ui-primary: #4f46e5;
    --pagefind-ui-text: #1e293b;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #cbd5e1;
    --pagefind-ui-tag: #e0e7ff;
    --pagefind-ui-border-radius: 0.75rem;
    --pagefind-ui-font: inherit;
  }
</style>
