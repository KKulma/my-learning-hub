---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';
import { getCourseTrees } from '../../lib/courses';

const trees = await getCourseTrees();
const courses = (await getCollection('courses')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const metaFor = (id: string) => {
  const tree = trees.get(id);
  if (!tree || tree.chapters.length === 0) return undefined;
  const c = tree.chapters.length;
  const p = tree.pages.length;
  return `${c} ${c === 1 ? 'chapter' : 'chapters'} · ${p} ${p === 1 ? 'page' : 'pages'}`;
};
---

<BaseLayout title="Courses" description="Course notes, modules, and certification preparation.">
  <div class="mb-8">
    <h1 class="text-3xl font-extrabold text-slate-900">Courses & Certifications</h1>
    <p class="text-slate-600 mt-2">Study logs, module summaries, and certificate tracking.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {courses.map((course) => (
      <Card
        title={course.data.title}
        description={course.data.description}
        type="course"
        slug={course.id}
        date={course.data.date}
        tags={course.data.tags}
        provider={course.data.provider}
        status={course.data.status}
        meta={metaFor(course.id)}
      />
    ))}
  </div>
</BaseLayout>
