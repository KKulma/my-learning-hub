---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

const rawResources = await getCollection('resources');
const rawCourses = await getCollection('courses');

const allItems = [
  ...rawResources.map(item => ({
    type: 'resource' as const,
    slug: item.id,
    data: item.data,
  })),
  ...rawCourses.map(item => ({
    type: 'course' as const,
    slug: item.id,
    data: item.data,
  })),
].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Collect all unique tags with counts
const tagCounts: Record<string, number> = {};
allItems.forEach(item => {
  (item.data.tags || []).forEach(tag => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <section class="mb-10 text-center max-w-2xl mx-auto">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
      Kasia's Learning Hub
    </h1>
    <p class="text-slate-600 text-base sm:text-lg">
      My take on papers, courses, and certification prep.
    </p>
  </section>

  <!-- Interactive Search & Filter Controls -->
  <section class="mb-8 space-y-4">
    <!-- Search Bar -->
    <div class="relative max-w-xl mx-auto">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        type="text"
        id="hub-search"
        placeholder="Filter by title, keywords, or topics..."
        class="w-full pl-10 pr-4 py-2.5 bg-white border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent shadow-sm text-sm"
      />
    </div>

    <!-- Category Tabs -->
    <div class="flex items-center justify-center gap-2 text-xs sm:text-sm">
      <button class="filter-tab active px-3.5 py-1.5 rounded-full font-medium transition bg-indigo-600 text-white" data-type="all">
        All ({allItems.length})
      </button>
      <button class="filter-tab px-3.5 py-1.5 rounded-full font-medium transition bg-slate-100 text-slate-700 hover:bg-slate-200" data-type="resource">
        Resources ({rawResources.length})
      </button>
      <button class="filter-tab px-3.5 py-1.5 rounded-full font-medium transition bg-slate-100 text-slate-700 hover:bg-slate-200" data-type="course">
        Courses ({rawCourses.length})
      </button>
    </div>

    <!-- Tag Cloud ("Bubbles") -->
    {sortedTags.length > 0 && (
      <div class="pt-2 text-center">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Browse Popular Tags</p>
        <div class="flex flex-wrap justify-center gap-1.5 max-w-3xl mx-auto" id="tag-cloud">
          {sortedTags.map(([tag, count]) => (
            <button
              class="tag-filter-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-white text-slate-700 border border-slate-200 hover:border-indigo-400 hover:text-indigo-600 transition shadow-2xs"
              data-tag={tag.toLowerCase()}
            >
              <span>#{tag}</span>
              <span class="text-[10px] text-slate-400">({count})</span>
            </button>
          ))}
        </div>
      </div>
    )}
  </section>

  <!-- Items Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="items-grid">
    {allItems.map((item) => (
      <div
        class="item-card-wrapper"
        data-type={item.type}
        data-title={item.data.title.toLowerCase()}
        data-description={item.data.description.toLowerCase()}
        data-tags={JSON.stringify((item.data.tags || []).map(t => t.toLowerCase()))}
      >
        <Card
          title={item.data.title}
          description={item.data.description}
          type={item.type}
          slug={item.slug}
          date={item.data.date}
          tags={item.data.tags}
          category={'category' in item.data ? item.data.category : undefined}
          url={'url' in item.data ? item.data.url : undefined}
          provider={'provider' in item.data ? item.data.provider : undefined}
          status={'status' in item.data ? item.data.status : undefined}
          rating={'rating' in item.data ? item.data.rating : undefined}
        />
      </div>
    ))}
  </div>

  <div id="no-results" class="hidden text-center py-16">
    <div class="text-4xl mb-3">🔍</div>
    <h3 class="text-lg font-semibold text-slate-800">No matching entries found</h3>
    <p class="text-sm text-slate-500 mt-1">Try clearing filters or search terms.</p>
  </div>
</BaseLayout>

<script>
  let activeType = 'all';
  let activeTag = '';
  let searchQuery = '';

  const searchInput = document.getElementById('hub-search') as HTMLInputElement | null;
  const typeButtons = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const tagButtons = document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.item-card-wrapper');
  const noResults = document.getElementById('no-results');

  function filterItems() {
    let visibleCount = 0;

    cards.forEach(card => {
      const type = card.dataset.type || '';
      const title = card.dataset.title || '';
      const desc = card.dataset.description || '';
      const tags: string[] = JSON.parse(card.dataset.tags || '[]');

      const matchesType = activeType === 'all' || type === activeType;
      const matchesTag = !activeTag || tags.includes(activeTag);
      const matchesSearch = !searchQuery ||
        title.includes(searchQuery) ||
        desc.includes(searchQuery) ||
        tags.some(t => t.includes(searchQuery));

      if (matchesType && matchesTag && matchesSearch) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount > 0);
    }
  }

  // Type filter handlers
  typeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      typeButtons.forEach(b => {
        b.classList.remove('bg-indigo-600', 'text-white');
        b.classList.add('bg-slate-100', 'text-slate-700');
      });
      btn.classList.remove('bg-slate-100', 'text-slate-700');
      btn.classList.add('bg-indigo-600', 'text-white');
      activeType = btn.dataset.type || 'all';
      filterItems();
    });
  });

  // Tag filter handlers
  tagButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const clickedTag = btn.dataset.tag || '';
      if (activeTag === clickedTag) {
        // Toggle off
        activeTag = '';
        btn.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-600');
        btn.classList.add('bg-white', 'text-slate-700');
      } else {
        tagButtons.forEach(b => {
          b.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-600');
          b.classList.add('bg-white', 'text-slate-700');
        });
        activeTag = clickedTag;
        btn.classList.remove('bg-white', 'text-slate-700');
        btn.classList.add('bg-indigo-600', 'text-white', 'border-indigo-600');
      }
      filterItems();
    });
  });

  // Search input handler
  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
    filterItems();
  });
</script>
