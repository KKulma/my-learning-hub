---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="Notes" description="Technical guides, architecture notes, and AI engineering writeups.">
  <div class="mb-8">
    <h1 class="text-3xl font-extrabold text-slate-900">Technical Notes</h1>
    <p class="text-slate-600 mt-2">Short & long form summaries of AI architectures, workflows, and concepts.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {notes.map((note) => (
      <Card
        title={note.data.title}
        description={note.data.description}
        type="note"
        slug={note.slug}
        date={note.data.date}
        tags={note.data.tags}
        category={note.data.category}
      />
    ))}
  </div>
</BaseLayout>
